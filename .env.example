# ─────────────────────────────────────────────────────────────────
#  D'Awesome Bot v3 — Environment Variables
#  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_telegram_user_id_here

# ── D'Awesome API ──────────────────────────────────────────
CLAUDE_API_BASE=https://my-api-rzmb.onrender.com/api/ai/Claude-pro
# Model to use on Claude-pro endpoint (deepseek-v3.2 is smart & free)
# Other options: gpt-4o, claude-3-opus, llama-3, gemini-pro
OMEGA_MODEL=deepseek-v3.2

# ── PostgreSQL ────────────────────────────────────────────────────
# Fly.io sets this automatically when you attach Postgres
# Pterodactyl: set manually
DATABASE_URL=postgresql://user:password@localhost:5432/dawesomebot

# ── Image Vision (OPTIONAL but recommended) ───────────────────────
# If set, bot uses Anthropic API directly for image analysis
# Get free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Bot Config ────────────────────────────────────────────────────
NODE_ENV=production
MAX_FILE_SIZE_MB=50
TEMP_DIR=./temp
LOG_LEVEL=info
MAX_MESSAGES_PER_MINUTE=20

# ── FREE FALLBACK AI APIS (all optional, add any for better reliability) ───────
# Bot uses these in order when primary API fails:
#   1. Pollinations.ai GET/POST — FREE, NO KEY NEEDED (built-in)
#   2. HuggingFace — FREE, NO KEY NEEDED (built-in, optional key speeds it up)
#   3. Groq — FREE tier, fast llama3 — get key at: https://console.groq.com
#   4. OpenRouter — FREE models — get key at: https://openrouter.ai
#   5. Together AI — FREE $25 credit — get key at: https://api.together.xyz

# HuggingFace — optional key = faster, no key = still works (slower)
HUGGINGFACE_API_KEY=

# Groq — ultra-fast free tier (llama3) — get key at: https://console.groq.com
GROQ_API_KEY=

# OpenRouter — free models available — get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Together AI — free $25 credit — get key at: https://api.together.xyz
TOGETHER_API_KEY=
