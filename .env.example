# ─────────────────────────────────────────────────────────────────
#  D'Awesome Bot v2 — Environment Variables
#  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_telegram_user_id_here

# ── D'Awesome API ──────────────────────────────────────────
CLAUDE_API_BASE=https://my-api-rzmb.onrender.com/api/ai/Claude-pro

# ── PostgreSQL ────────────────────────────────────────────────────
# Fly.io sets this automatically when you attach Postgres
# Pterodactyl: set manually
DATABASE_URL=postgresql://user:password@localhost:5432/dawesomebot

# ── Image Vision (OPTIONAL but recommended) ───────────────────────
# If set, bot uses Anthropic API directly for image analysis
# Get free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Bot Config ────────────────────────────────────────────────────
NODE_ENV=production
MAX_FILE_SIZE_MB=50
TEMP_DIR=./temp
LOG_LEVEL=info
MAX_MESSAGES_PER_MINUTE=20
